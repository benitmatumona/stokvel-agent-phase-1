# Copy to .env (never commit .env). Everything here has a free tier.

# Optional: without a key the app uses a built-in regex fallback to read details.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: without a key the browser's own voice is used.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Set to 1 in tests: deploy/test tool calls are recorded, never executed.
STOKVEL_TEST_MODE=0
# Needed for the real /deploy: run `solana config set --url devnet` first.
# DEPLOY_COMMAND="yarn -s ts-node scripts/deploy_group.ts"

# Optional: Supabase persistence (run db/schema.sql first). Server-side key only.
SUPABASE_URL=
SUPABASE_KEY=
